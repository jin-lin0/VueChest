{
  "name": "vue3-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/knowledge/generate-doc-catalog.mjs --write && vite",
    "dev:prod": "node scripts/knowledge/generate-doc-catalog.mjs --write && vite --mode production",
    "build": "run-s docs:catalog type-check build-only build:budget build:routes",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "build:routes": "node scripts/check-route-budget.mjs",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "run-s lint test docs:validate build build:market",
    "format": "prettier --write src/",
    "build:market": "node scripts/build-market-apps.mjs",
    "publish:market": "node scripts/publish-market-apps-r2.mjs",
    "kb:pull": "node scripts/knowledge/kb-sync-raw.mjs --pull",
    "kb:validate": "node scripts/knowledge/validate-knowledge.mjs",
    "docs:catalog": "node scripts/knowledge/generate-doc-catalog.mjs --write",
    "docs:catalog:check": "node scripts/knowledge/generate-doc-catalog.mjs",
    "docs:validate": "pnpm docs:catalog:check && node scripts/knowledge/validate-docs-structure.mjs && pnpm interview:validate",
    "docs:audit": "node scripts/knowledge/audit-handbook-quality.mjs",
    "interview:validate": "node scripts/knowledge/validate-niuke-coverage.mjs && node scripts/knowledge/validate-interview-code.mjs",
    "kb:publish": "node scripts/knowledge/kb-sync-raw.mjs --push && node scripts/knowledge/build-knowledge.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.33.0",
    "@vuepic/vue-datepicker": "^13.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cron-parser": "^5.6.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "ini": "^7.0.0",
    "js-yaml": "^5.2.2",
    "lightweight-charts": "^5.2.0",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.0.4",
    "md-editor-v3": "^6.5.6",
    "pinia": "^3.0.3",
    "prettier": "3.6.2",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.7.1",
    "spark-md5": "^3.0.2",
    "three": "^0.184.0",
    "turndown": "^7.2.4",
    "ua-parser-js": "^2.0.10",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0",
    "web-audio-beat-detector": "^8.2.37"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.184.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "typescript": "~5.8.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.4"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.5": "3.1.5",
      "linkify-it@<5.0.2": "5.0.2",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.26"
    }
  }
}
