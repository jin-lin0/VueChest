{
  "name": "vue3-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "build:market": "node scripts/build-market-apps.mjs",
    "publish:market": "node scripts/publish-market-apps-r2.mjs",
    "kb:pull": "node scripts/knowledge/kb-sync-raw.mjs --pull",
    "kb:validate": "node scripts/knowledge/validate-knowledge.mjs",
    "kb:publish": "node scripts/knowledge/kb-sync-raw.mjs --push && node scripts/knowledge/build-knowledge.mjs"
  },
  "dependencies": {
    "@vuepic/vue-datepicker": "^13.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cron-parser": "^5.6.2",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "ini": "^7.0.0",
    "js-yaml": "^5.2.2",
    "lightweight-charts": "^5.2.0",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.0.4",
    "md-editor-v3": "^6.5.3",
    "pinia": "^3.0.3",
    "prettier": "3.6.2",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.7.1",
    "spark-md5": "^3.0.2",
    "three": "^0.184.0",
    "turndown": "^7.2.4",
    "ua-parser-js": "^2.0.10",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vuedraggable": "^4.1.0",
    "web-audio-beat-detector": "^8.2.37"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.184.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "sharp": "^0.34.5",
    "typescript": "~5.8.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.4"
  }
}
